# ─────────────────────────────────────────────────────────────────────────────
#  Take Care Connect Admin — production
#
#  Copy to .env on the server and fill in the four marked values. Everything
#  else is already set for Hostinger shared hosting and should be left alone.
#
#      cp .env.production.example .env
#      php artisan key:generate
#
#  Never commit the filled-in .env. It holds the database password and the key
#  that decrypts every session and every two-factor secret.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Take Care Connect Admin"
APP_ENV=production

# ← Generated on the server with `php artisan key:generate`. Deliberately blank
#   here: a key committed to a repository is not a key.
APP_KEY=

# ← Off. With it on, a stack trace on any error shows the database credentials
#   and the environment to whoever triggered it.
APP_DEBUG=false

APP_URL=https://admin.takecareconnect.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────────────────
# Its own database. This system never reads or writes the live site's `tcif`
# database, and pointing it at one would be a serious mistake rather than a
# shortcut — the two have different `users` tables with different roles.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                    # ← Hostinger prefixes these, e.g. u123456789_tcc_admin
DB_USERNAME=                    # ←
DB_PASSWORD=                    # ←

# ── Shared-hosting drivers ───────────────────────────────────────────────────
# No Redis and no supervisor on this plan, so: file cache, database sessions,
# and a database queue drained by the scheduler every minute.
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=480            # a working day — nobody should be signed out at lunch
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true      # the site is HTTPS-only; do not send the cookie over HTTP
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Logging ──────────────────────────────────────────────────────────────────
# Daily files with a fortnight kept: enough to investigate last week's problem,
# not so much that the disk quota goes to logs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# ── Security ─────────────────────────────────────────────────────────────────

BCRYPT_ROUNDS=12

# ── Mail ─────────────────────────────────────────────────────────────────────
# Notifications are in-app only, so nothing here is load-bearing today. It is
# wired up because password resets need it the day somebody locks themselves
# out, and that is a bad day to be configuring SMTP.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=admin@takecareconnect.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="admin@takecareconnect.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
